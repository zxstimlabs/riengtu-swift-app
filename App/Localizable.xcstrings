            "state" : "translated",
            "value" : "mỗi lượng"
          }
        }
      }
    },
    "“%@” comes off every transaction that has it. The transactions stay." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẻ “%@” sẽ được gỡ khỏi mọi giao dịch có thẻ này. Các giao dịch vẫn được giữ lại."
          }
