    },
    "Tap New Blank Automation, and add the action Add Payment to Inbox." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào Mục tự động hóa trống mới, rồi thêm tác vụ Thêm khoản thanh toán vào Giao dịch chờ."
          }
        }
      }
    },
    "Tap a payment to add it as an expense, or swipe to dismiss it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào một khoản để thêm làm khoản chi, hoặc vuốt để bỏ qua."
          }
        }
      }
    },
    "That was money received, so it wasn’t added." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là tiền vào nên không được thêm."
          }
        }
      }
    },
    "That’s already in the inbox." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao dịch này đã có trong Giao dịch chờ."
          }
        }
      }
    },
    "There was nothing to add." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì để thêm."
          }
        }
      }
    },
    "This deletes every expense and asset from this device. You can’t undo this." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa mọi khoản chi và tài sản khỏi thiết bị này. Bạn không thể hoàn tác."
          }
