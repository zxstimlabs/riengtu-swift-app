    },
    "Tap New Blank Automation, and add the action Add Bank Message to Inbox." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào Mục tự động hóa trống mới, rồi thêm tác vụ Thêm thông báo ngân hàng vào Giao dịch chờ."
