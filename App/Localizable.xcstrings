    "Weight" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trọng lượng"
          }
        }
      }
    },
    "What it would sell for today." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số tiền bạn có thể bán được hôm nay."
          }
        }
      }
    },
    "What you add or dismiss from the inbox stays here with its message for a while, then it’s deleted." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những gì bạn thêm hoặc bỏ qua từ Giao dịch chờ được giữ ở đây cùng tin nhắn gốc một thời gian, rồi sẽ bị xóa."
          }
        }
      }
    },
    "Work" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công việc"
          }
        }
      }
    },
    "Worship & Offerings" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâm linh"
          }
        }
      }
    },
    "Yesterday" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm qua"
          }
        }
      }
    },
    "Your bank’s notifications and emails, and your Apple Pay payments, wait here once Shortcuts sends them, for you to check and add. You can add past transactions from screenshots too." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo và email của ngân hàng, cùng các khoản thanh toán Apple Pay, sẽ chờ ở đây khi Phím tắt gửi đến, để bạn kiểm tra và thêm. Bạn cũng có thể thêm giao dịch trước đây từ ảnh chụp màn hình."
          }
        }
      }
    },
    "chỉ" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chỉ"
          }
        }
      }
