    "Riengtu Is Locked" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riengtu đang khóa"
          }
        }
      }
    },
    "Riengtu can’t read the expenses saved on this device. They may be from a newer version of Riengtu, so try updating the app." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riengtu không đọc được các khoản chi đã lưu trên thiết bị này. Có thể chúng được lưu bởi phiên bản Riengtu mới hơn, nên hãy thử cập nhật ứng dụng."
          }
        }
      }
    },
    "Riengtu couldn’t save your change. Try again." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riengtu không lưu được thay đổi của bạn. Hãy thử lại."
          }
        }
      }
    },
    "Riengtu has no account and doesn’t connect to the internet. Your spending is stored only on this device and in its backups." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riengtu không cần tài khoản và không kết nối internet. Chi tiêu của bạn chỉ được lưu trên thiết bị này và trong bản sao lưu của thiết bị."
          }
        }
      }
    },
    "Riengtu keeps the unreadable data on this device but won’t show it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riengtu vẫn giữ dữ liệu không đọc được trên thiết bị này nhưng sẽ không hiển thị."
          }
        }
      }
    },
    "Riengtu uses your device’s language. You can choose a different language for Riengtu in Settings." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riengtu dùng ngôn ngữ của thiết bị. Bạn có thể chọn ngôn ngữ khác cho Riengtu trong Cài đặt."
          }
        }
      }
    },
