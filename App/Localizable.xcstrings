            "value" : "Thẻ"
          }
        }
      }
    },
    "Tags say what an expense was for, such as work or a trip." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẻ cho biết khoản chi dành cho việc gì, như công việc hay một chuyến đi."
          }
        }
      }
    },
    "Tap Message in the action, and choose Shortcut Input." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
